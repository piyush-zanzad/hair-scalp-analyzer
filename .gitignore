# ==============================================================================
# Git Ignore Configuration - Explainable Scalp & Hair Loss Analyzer Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python, Virtual Environments & Bytecode
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 2. Frontend / Node.js & Vite Build Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.dist/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm

# ------------------------------------------------------------------------------
# 3. Databases & Local State
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
scalp_analysis.db
backend/scalp_analysis.db

# ------------------------------------------------------------------------------
# 4. Large Datasets (Excludes 700MB+ raw training images to keep GitHub fast)
# ------------------------------------------------------------------------------
training/datasets/*
!training/datasets/.gitkeep

# ------------------------------------------------------------------------------
# 5. Duplicate Model Weights (Production weights live in backend/models/)
# ------------------------------------------------------------------------------
training/models/*.pth

# ------------------------------------------------------------------------------
# 6. User Uploads, Temp Files & Generated PDF Reports
# ------------------------------------------------------------------------------
backend/static/uploads/*
!backend/static/uploads/.gitkeep
backend/static/reports/*
!backend/static/reports/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/temp/*
!backend/temp/.gitkeep
backend/backend/

# ------------------------------------------------------------------------------
# 7. Environment & Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------------------------------
# 8. IDE, OS & Archive Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.log
logs/
*.zip
*.tar
*.gz
*.rar
*.7z
